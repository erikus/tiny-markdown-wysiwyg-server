# mdedit systemd user unit. Install as a symlink with `make install`;
# this file in the repo is the single source of truth.
#
# Flags come from MDEDIT_FLAGS in ~/.config/mdedit/env; see
# examples/env.example.

[Unit]
Description=mdedit - browser Markdown editor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/mdedit/env
ExecStart=%h/code/mdedit/bin/mdedit $MDEDIT_FLAGS
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
