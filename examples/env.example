# Copy to ~/.config/mdedit/env. Read by deploy/mdedit.service, which runs
#   mdedit $MDEDIT_FLAGS
#
# Every flag is documented in README.md. --root is repeatable; NAME becomes
# the URL prefix (https://edit.<tailnet>.ts.net/edit/NAME/path/to/file.md).
#
# Plain-HTTP alternative for localhost only: replace --tsnet-hostname with
#   --listen 127.0.0.1:8585

MDEDIT_FLAGS=--root notes=/home/me/notes --root docs=/home/me/docs --tsnet-hostname edit --view-base https://files.example.com

# Optional: first-run Tailscale auth without clicking a login URL.
#TS_AUTHKEY=tskey-auth-...
